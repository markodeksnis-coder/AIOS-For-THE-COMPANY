# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma — dev.db is a rebuildable index, never source of truth. Prisma's
# CLI resolves a relative "file:" URL against prisma/schema.prisma's
# directory, but the app's own runtime client (src/lib/db.ts) resolves the
# same URL against the process cwd — so a local dev.db can end up in
# either place depending on whether the CLI or the running app created it.
/prisma/dev.db
/prisma/dev.db-journal
/dev.db
/dev.db-journal

# python cruft from an earlier, now-removed backend
__pycache__/
*.pyc
.pytest_cache/
