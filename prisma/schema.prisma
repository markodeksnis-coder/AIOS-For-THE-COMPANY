// The database is a search index and live-data store — never the source
// of truth. Everything in BrainFile is rebuilt from /brain by
// `npm run sync-brain` and is safe to delete and regenerate at any time.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model BrainFile {
  id         String   @id @default(cuid())
  path       String   @unique // relative path from /brain, e.g. "departments/marketing/department.yaml"
  slug       String   @unique // url-safe id used for [[wikilinks]] and routing, e.g. "marketing-department"
  title      String
  type       String // company | department | doc | system | agent | app | course | lesson | project | person | template | meeting | decision | scorecard | playbook
  department String?
  owner      String?
  status     String
  updated    String
  tags       String // JSON-encoded string[]
  links      String // JSON-encoded string[] of slugs this file declares a link to
  body       String // raw markdown/YAML body, frontmatter stripped
  excerpt    String // first ~200 chars of body, for search results

  @@index([type])
  @@index([department])
}

// Live data — real, not rebuilt from /brain. Unlike BrainFile, this is
// never safe to delete.

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  status      String   @default("planning") // planning | active | paused | done
  department  String? // matches a /brain department slug, e.g. "marketing"
  targetDate  String? // ISO date (YYYY-MM-DD), optional
  tags        String   @default("[]") // JSON string[] — freeform labels, e.g. ["q1", "client-facing"]
  order       Int      @default(0) // drag position within its status column
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  issues      Issue[]

  @@index([status])
  @@index([department])
}

model Issue {
  id          String         @id @default(cuid())
  title       String
  description String?
  status      String         @default("todo") // backlog | todo | in_progress | done | canceled
  priority    String         @default("none") // none | low | medium | high | urgent
  department  String? // matches a /brain department slug
  assignee    String? // a /brain person slug, e.g. "marko" — free text, not a hard FK
  dueDate     String? // ISO date (YYYY-MM-DD), optional
  order       Int            @default(0) // drag position within its status column
  projectId   String?
  project     Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  comments    IssueComment[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([status])
  @@index([department])
  @@index([projectId])
}

model IssueComment {
  id        String   @id @default(cuid())
  issueId   String
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  author    String   @default("Marko")
  body      String
  createdAt DateTime @default(now())

  @@index([issueId])
}

// A single logged number for one KPI in one period. The KPI itself (name,
// target, department) is defined in /brain — this just tracks the real
// numbers over time against that definition.
model ScorecardEntry {
  id         String   @id @default(cuid())
  department String // matches a /brain department slug
  kpiName    String // matches a kpi "name" from that department's department.yaml
  period     String // ISO date (YYYY-MM-DD) — the day this number is logged for
  value      Float
  note       String?
  createdAt  DateTime @default(now())

  @@index([department, kpiName])
}

// One autonomous, unprompted run of an agent (e.g. a daily check-in) —
// distinct from a chat message, which a person typed. This is the audit
// trail the Activity feed reads from.
model AgentActivity {
  id         String   @id @default(cuid())
  agentSlug  String // matches a /brain agent file's slug
  agentTitle String // denormalized so the feed survives an agent being renamed
  department String?
  kind       String // "daily_digest" for now — room for more kinds later
  summary    String // the agent's own short write-up of what it found/did
  actions    String // JSON-encoded { tool: string; summary: string }[]
  createdAt  DateTime @default(now())

  @@index([agentSlug])
  @@index([createdAt])
}

// Inside Sales CRM — always sales department; no `department` column needed
// since this whole model group only exists for Sales.

// 7-stage pipeline: new_lead -> booked_unconfirmed -> confirmed -> showed
// -> (no_show | closed_won | closed_lost). No more stages than this —
// deliberately, so the data stays disciplined enough to trust.
model Lead {
  id               String   @id @default(cuid())
  name             String
  email            String?
  phone            String?
  timezone         String?
  source           String? // e.g. "facebook ads", "referral", "organic", "cold outreach"
  funnel           String? // campaign/funnel name
  productInterest  String?
  targetPrice      Float?
  repName          String? // free text, mirrors Issue.assignee — not a hard FK
  stage            String   @default("new_lead")
  tags             String   @default("[]") // JSON string[] — avatar tags, behavior tags, reactivation tags, all freeform
  notes            String?
  dealValue        Float? // used for the Expected Value ranking: dealValue * stageProbability
  stageProbability Float? // 0-100
  lossReason       String? // required in practice once stage = closed_lost; enforced in the action, not the DB
  cashCollected    Float    @default(0) // running total collected across every call
  order            Int      @default(0) // drag position within its stage column
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  calls            SalesCall[]
  drafts           LeadDraft[]

  @@index([stage])
  @@index([source])
}

// One logged call for a lead. A lead can have several over time (e.g. a
// no-show gets rebooked, or a "booked 2nd call" disposition leads to
// another row later) — this is the full call history; Lead.stage is just
// the lead's current state, derived from the most recent disposition.
model SalesCall {
  id            String   @id @default(cuid())
  leadId        String
  lead          Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  scheduledAt   String // ISO date (YYYY-MM-DD) the call was/is booked for
  outcome       String   @default("no_show") // no_show | booked_2nd_call | pif | plan | no_money | not_a_fit | canceled
  rep           String?
  recordingLink String?
  planLength    String? // e.g. "6 months", only meaningful when outcome is "plan"
  lossReason    String? // only meaningful when outcome is no_money/not_a_fit
  cashCollected Float? // amount collected specifically on this call, if pif/plan
  notes         String?
  createdAt     DateTime @default(now())

  @@index([leadId])
  @@index([outcome])
  @@index([scheduledAt])
}

// An agent-drafted follow-up for a lead — a suggestion the founder reviews
// and sends themselves, never sent automatically.
model LeadDraft {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  kind      String // "no_show_followup" | "closed_lost_followup"
  channel   String // "email" | "sms" | "loom_script"
  content   String
  createdAt DateTime @default(now())

  @@index([leadId])
}
