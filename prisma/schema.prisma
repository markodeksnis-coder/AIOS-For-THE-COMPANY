// The database is a search index and live-data store — never the source
// of truth. Everything in BrainFile is rebuilt from /brain by
// `npm run sync-brain` and is safe to delete and regenerate at any time.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model BrainFile {
  id         String   @id @default(cuid())
  path       String   @unique // relative path from /brain, e.g. "departments/marketing/department.yaml"
  slug       String   @unique // url-safe id used for [[wikilinks]] and routing, e.g. "marketing-department"
  title      String
  type       String // company | department | doc | system | agent | app | course | lesson | project | person | template | meeting | decision | scorecard | playbook
  department String?
  owner      String?
  status     String
  updated    String
  tags       String // JSON-encoded string[]
  links      String // JSON-encoded string[] of slugs this file declares a link to
  body       String // raw markdown/YAML body, frontmatter stripped
  excerpt    String // first ~200 chars of body, for search results

  @@index([type])
  @@index([department])
}

// Live data — real, not rebuilt from /brain. Unlike BrainFile, this is
// never safe to delete.

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  status      String   @default("planning") // planning | active | paused | done
  department  String? // matches a /brain department slug, e.g. "marketing"
  targetDate  String? // ISO date (YYYY-MM-DD), optional
  tags        String   @default("[]") // JSON string[] — freeform labels, e.g. ["q1", "client-facing"]
  order       Int      @default(0) // drag position within its status column
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  issues      Issue[]

  @@index([status])
  @@index([department])
}

model Issue {
  id          String         @id @default(cuid())
  title       String
  description String?
  status      String         @default("todo") // backlog | todo | in_progress | done | canceled
  priority    String         @default("none") // none | low | medium | high | urgent
  department  String? // matches a /brain department slug
  assignee    String? // a /brain person slug, e.g. "marko" — free text, not a hard FK
  dueDate     String? // ISO date (YYYY-MM-DD), optional
  order       Int            @default(0) // drag position within its status column
  projectId   String?
  project     Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  comments    IssueComment[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([status])
  @@index([department])
  @@index([projectId])
}

model IssueComment {
  id        String   @id @default(cuid())
  issueId   String
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  author    String   @default("Marko")
  body      String
  createdAt DateTime @default(now())

  @@index([issueId])
}

// A single logged number for one KPI in one period. The KPI itself (name,
// target, department) is defined in /brain — this just tracks the real
// numbers over time against that definition.
model ScorecardEntry {
  id         String   @id @default(cuid())
  department String // matches a /brain department slug
  kpiName    String // matches a kpi "name" from that department's department.yaml
  period     String // ISO date (YYYY-MM-DD) — the day this number is logged for
  value      Float
  note       String?
  createdAt  DateTime @default(now())

  @@index([department, kpiName])
}

// One autonomous, unprompted run of an agent (e.g. a daily check-in) —
// distinct from a chat message, which a person typed. This is the audit
// trail the Activity feed reads from.
model AgentActivity {
  id         String   @id @default(cuid())
  agentSlug  String // matches a /brain agent file's slug
  agentTitle String // denormalized so the feed survives an agent being renamed
  department String?
  kind       String // "daily_digest" for now — room for more kinds later
  summary    String // the agent's own short write-up of what it found/did
  actions    String // JSON-encoded { tool: string; summary: string }[]
  createdAt  DateTime @default(now())

  @@index([agentSlug])
  @@index([createdAt])
}

// A correction or preference the founder gave an agent in chat — "next
// time, always mention X" — that the agent should keep applying in every
// future conversation, not just remember for the rest of this one. This is
// the honest substitute for fine-tuning: buildAgentSystemPrompt injects
// every note for the department into the system prompt, so a saved
// correction actually changes future behavior instead of just sitting in
// a chat log nobody re-reads.
model CoachingNote {
  id         String   @id @default(cuid())
  department String
  content    String
  createdAt  DateTime @default(now())

  @@index([department])
}

// Inside Sales CRM — always sales department; no `department` column needed
// since this whole model group only exists for Sales.

// 7-stage pipeline: new_lead -> booked_unconfirmed -> confirmed -> showed
// -> (no_show | closed_won | closed_lost). No more stages than this —
// deliberately, so the data stays disciplined enough to trust.
model Lead {
  id               String   @id @default(cuid())
  name             String
  email            String?
  phone            String?
  company          String?
  timezone         String?
  source           String? // e.g. "facebook ads", "referral", "organic", "cold outreach"
  funnel           String? // campaign/funnel name
  productInterest  String?
  targetPrice      Float?
  repName          String? // free text, mirrors Issue.assignee — not a hard FK
  stage            String   @default("new_lead")
  // Set every time `stage` changes (drag on the board, a call disposition,
  // a webhook) — never touched otherwise — so the pipeline can show how
  // long a lead has actually sat in its current stage, not just its age.
  stageChangedAt   DateTime @default(now())
  tags             String   @default("[]") // JSON string[] — avatar tags, behavior tags, reactivation tags, all freeform
  notes            String?
  dealValue        Float? // used for the Expected Value ranking: dealValue * stageProbability
  stageProbability Float? // 0-100
  lossReason       String? // required in practice once stage = closed_lost; enforced in the action, not the DB
  cashCollected    Float    @default(0) // running total collected across every call
  order            Int      @default(0) // drag position within its stage column

  // Qualification — filled in by hand or, when the question wording on a
  // Calendly booking form matches (see calendly.ts), auto-parsed from the
  // invitee's answers.
  location            String? // free text, e.g. "Austin, TX"
  instagramOrLinkedin String?
  yearsRunningAgency  Float?
  monthlyRevenue      Float?
  sellsService        String? // free-text answer to "do you currently sell/run paid ads" style question

  // The next upcoming booked call, if any — distinct from SalesCall, which
  // only records calls that have already happened. Set by the Calendly
  // webhook on booking, cleared on cancellation.
  nextCallAt        DateTime?
  calendlyEventUri  String? // Calendly's event URI — lets a reschedule/cancel webhook find the right lead

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  calls            SalesCall[]
  drafts           LeadDraft[]

  @@index([stage])
  @@index([source])
  @@index([calendlyEventUri])
}

// One logged call for a lead. A lead can have several over time (e.g. a
// no-show gets rebooked, or a "booked 2nd call" disposition leads to
// another row later) — this is the full call history; Lead.stage is just
// the lead's current state, derived from the most recent disposition.
model SalesCall {
  id            String   @id @default(cuid())
  leadId        String
  lead          Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  scheduledAt   String // ISO date (YYYY-MM-DD) the call was/is booked for
  rep           String?
  recordingLink String?
  planLength    String? // e.g. "6 months", only meaningful when result is "closed_won" and it was a payment plan
  lossReason    String? // only meaningful when result is closed_lost/not_qualified
  cashCollected Float? // amount collected specifically on this call
  notes         String?
  createdAt     DateTime @default(now())

  // Two separate axes, deliberately not one combined field: callStatus is
  // what happened with the appointment itself (did they show up), result is
  // the sales disposition — only meaningful once callStatus is "showed".
  // A call can be callStatus="showed" with result still null (Fathom's
  // "pending disposition" placeholder, or a rep logging attendance before
  // filling in what happened) — see logSalesCall in lib/actions/leads.ts.
  callStatus String  @default("booked") // booked | showed | no_show | cancelled | rescheduled
  result     String? // closed_won | closed_lost | follow_up | not_qualified

  // Set when this row was created (or updated) by the Fathom webhook — lets
  // a retried webhook delivery update the same row instead of duplicating
  // it. Null for every call logged by hand.
  fathomRecordingId String? @unique

  // Set when this row was created by the Calendly webhook — Calendly's own
  // invitee URI for this specific booking instance. A reschedule delivers
  // as invitee.canceled (old booking) + invitee.created (new booking, with
  // the old invitee's URI attached) rather than its own event type — the
  // webhook finds the row by this field and updates it in place with the
  // new URI/time instead of creating a second row. Null for every call not
  // sourced from Calendly.
  calendlyInviteeUri String? @unique

  // Fathom-only enrichment — null for every call logged by hand. transcript
  // is the full call transcript (when Fathom's webhook is configured to
  // include it); startedAt is the exact start time, letting the Sales Coach
  // agent disambiguate same-day calls ("yesterday's 2pm call") since
  // scheduledAt is date-only. aiSummary is Fathom's own generated summary —
  // kept separate from `notes` so a rep typing manual notes later never
  // overwrites it.
  transcript String?
  startedAt  DateTime?
  aiSummary  String?

  debrief CallDebrief?

  @@index([leadId])
  @@index([callStatus])
  @@index([scheduledAt])
}

// The post-call debrief — answers to the 13-question sheet run after every
// sales call. One per SalesCall. The callStatus/result themselves
// (closed/no-show/etc.) already live on SalesCall — this is the "why", not
// the "what".
model CallDebrief {
  id          String    @id @default(cuid())
  salesCallId String    @unique
  salesCall   SalesCall @relation(fields: [salesCallId], references: [id], onDelete: Cascade)

  endReason        String? // one sentence: why did it end that way
  notEstablished   String? // what wasn't established enough to force a close/no-close
  scriptAdherence  Int? // 1-10, followed the script start to finish
  weakestStep      String? // opening | discovery | diagnosis | pitch | close
  prospectDream    String? // their dream outcome, in their exact words
  prospectBlocker  String? // what's really holding them back, in their words
  commitmentScore  Int? // 1-10 — how badly they said they want to fix it
  finalObjection   String? // the exact sentence that stopped the sale
  objectionType    String? // money | belief | trust | timing | other
  objectionOther   String? // detail when objectionType is "other"
  doubtMoment      String? // when their energy/doubt first showed, and what preceded it
  replayMoment     String? // the 60 seconds they'd redo, and what they'd say instead
  rootCause        String? // script | skill | lead — pick one

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([weakestStep])
  @@index([rootCause])
  @@index([createdAt])
}

// An agent-drafted follow-up for a lead — a suggestion the founder reviews
// and sends themselves, never sent automatically.
model LeadDraft {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  kind      String // "no_show_followup" | "closed_lost_followup"
  channel   String // "email" | "sms" | "loom_script"
  content   String
  createdAt DateTime @default(now())

  @@index([leadId])
}

// One row per inbound webhook delivery — Fathom today, Calendly reuses the
// same log (see CRM Task 6). Lets the founder see delivery failures
// without digging through Vercel logs, and gives the "fire a test event"
// button something real to show the outcome of.
model WebhookEvent {
  id        String   @id @default(cuid())
  source    String // "fathom" | "calendly"
  eventType String? // the provider's own event/type field, when present
  status    String // "processed" | "unmatched" | "ignored" | "invalid_signature" | "error"
  message   String // short human-readable outcome, e.g. "Matched Jordan Blake by email" or the error text
  isTest    Boolean  @default(false) // fired from "Fire test event", not a real delivery
  createdAt DateTime @default(now())

  @@index([source, createdAt])
}

// A webhook event that arrived with a verified signature but matched no
// lead — held here instead of being silently dropped, so it can be
// assigned to the right lead in one click from /sales/crm/unmatched.
model UnmatchedCall {
  id                String    @id @default(cuid())
  source            String // "fathom" | "calendly"
  fathomRecordingId String?   @unique
  recordingLink     String?
  aiSummary         String?
  transcript        String?
  scheduledAt       String? // ISO date (YYYY-MM-DD)
  startedAt         DateTime?
  attendeeEmail     String?
  attendeeName      String?
  attendeePhone     String?
  createdAt         DateTime  @default(now())

  @@index([source, createdAt])
}
