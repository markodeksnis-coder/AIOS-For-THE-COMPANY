# Get these from the Turso dashboard (turso.tech) for your database.
# Local-file mode ("file:./dev.db") also works if you don't need data to
# persist between runs — but Vercel's filesystem is read-only at runtime,
# so the deployed site needs the real Turso values here.
DATABASE_URL="libsql://your-database.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token"

# Required for any agent chat under /agents/[slug]/chat (e.g. Sales Coach)
# to actually work — get a key from console.anthropic.com. Without this,
# the chat API returns a clear "not configured" error instead of failing
# silently.
ANTHROPIC_API_KEY="sk-ant-..."

# Required for the daily autonomous agent run (vercel.json's cron, hitting
# /api/cron/daily) to work. Any random string — generate one with
# `openssl rand -hex 32`. Vercel automatically sends this same value as
# `Authorization: Bearer <CRON_SECRET>` on its own cron requests once this
# env var is set, so the route can reject anyone else who calls it.
CRON_SECRET="a-long-random-string"

# Required for Calendly bookings to auto-create leads in the Inside Sales
# CRM (/api/webhooks/calendly). See docs/calendly-setup.md for the
# one-time setup — these come from your own Calendly account, not
# something Claude can generate.
CALENDLY_WEBHOOK_SIGNING_KEY="returned once when you register the webhook"
CALENDLY_API_TOKEN="your-calendly-personal-access-token"

# Required for Fathom call recordings to auto-attach to the matching CRM
# lead (/api/webhooks/fathom). See docs/fathom-setup.md for the one-time
# setup — this comes from your own Fathom account, not something Claude
# can generate. Note this is the only Fathom env var the app needs — no
# API key/token is required at runtime, only this webhook signing secret.
FATHOM_WEBHOOK_SIGNING_KEY="returned once when you create the webhook"
